# Copy this file to .env.local and paste your own keys in.
# .env.local is git-ignored and must never be committed.

# --- Supabase (Phase 0) -------------------------------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Who runs the platform -----------------------------------------------
# Comma-separated emails that may appoint founders. Set your own on the live site.
PLATFORM_OWNER_EMAILS=

# --- Claude API (Phase 1) -----------------------------------------------
# console.anthropic.com → API keys. Set a monthly spend limit while you are there.
ANTHROPIC_API_KEY=

# --- Resend (Phase 5, invites by email) ---------------------------------
RESEND_API_KEY=

# --- Banners on phones and laptops (Phase 5) -----------------------------
# Make a pair with:  npx web-push generate-vapid-keys
# The public one is safe in the browser; the private one is server-side only.
# Use a different pair for the live site. Without these, banners stay off and the bell still works.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Key that seals stored chat messages. 32 random bytes, base64. Without it production cannot send or open messages.
# Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAT_ENCRYPTION_KEY=
